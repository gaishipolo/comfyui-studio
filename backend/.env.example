# ComfyUI Workbench 配置示例。复制为 backend/.env 后按需修改。
# 请从 backend/ 目录启动后端；下列数据库和目录相对路径都以该工作目录为基准。

# 应用
APP_NAME=ComfyUI Workbench
APP_VERSION=0.1.0
APP_TIMEZONE=Asia/Shanghai
# development = 本地开发，配置问题只警告；production = 部署环境，关键配置缺失
# 会在启动时拒绝启动（SECRET_KEY 未配、前端产物缺失、存储目录不可写等）。
# 容器镜像和 Windows 服务脚本都会覆盖成 production，这里保持 development。
APP_ENV=development

# 安全。生产环境必须设置随机 SECRET_KEY，并把 CORS_ORIGINS 收紧为前端域名。
# ADMIN_INITIAL_PASSWORD 留空时，首次启动会生成随机密码并在控制台打印一次。
SECRET_KEY=
ADMIN_INITIAL_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQL_ECHO=false

# 数据库（当前支持 SQLite + aiosqlite）
DATABASE_URL=sqlite+aiosqlite:///./workbench.db

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=300
# 连 ComfyUI 时是否继承系统代理。内网地址保持 false（默认）——
# 本机开着 Clash 之类的代理软件时，代理会接管内网请求；而代理端口随软件重启
# 会变，已缓存的连接会一直指向旧端口，表现为「平台一直显示 ComfyUI 离线，
# 重启后端才好」。只有 ComfyUI 在必须走代理的网络上时才设为 true。
COMFYUI_TRUST_ENV=false

# 其他生成引擎一律走插件机制：管理员在前端「引擎插件」页上传 Provider .py，
# 配置项由插件自己的 config_schema 声明、存 DB（不写进 .env）。
# 开发规范见 docs/provider-dev-guide.md。

# 文件存储与工作流
STORAGE_BACKEND=local
STORAGE_DIR=./storage
WORKFLOW_DIR=./workflows
# Settings 字段；留空时依次查找系统 ffmpeg 和 imageio-ffmpeg 自带二进制。
FFMPEG_PATH=
FRONTEND_DIST=../frontend/dist

# MinIO / S3 兼容存储（仅 STORAGE_BACKEND=minio 时使用）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=comfyui-workbench
MINIO_SECURE=false
MINIO_REGION=

# ── 流程编排 Agent（OpenAI 兼容 /chat/completions）──
# 留空 = 未启用，界面会提示改用人工编排，不会静默失败。
# LLM_BASE_URL 填根地址（https://api.deepseek.com）或 /v1 都行，系统自动补
# /chat/completions；本地 Ollama 用 http://127.0.0.1:11434/v1，API key 可留空。
# 模型只负责写流程配置：生成结果一律是草稿，要试跑 + 人审批才上线。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 单次生成超时（秒）。生成长 JSON 比聊天慢，别设太小。
LLM_TIMEOUT=90
# 校验不过时把错误回喂给模型自修的次数。3 次足够，再多是在烧钱。
LLM_MAX_ATTEMPTS=3
# 访问外部模型是否继承系统代理。国内访问 OpenAI 之类通常需要，默认开启。
LLM_TRUST_ENV=true

# 任务调度
MAX_CONCURRENT_TASKS=2
# 重启时是否把「排队中、还没提交到引擎」的任务重新排一遍
# （关掉会把这些任务标成失败让用户手动重试）
RESUME_PENDING_ON_STARTUP=true
TASK_POLL_INTERVAL=2.0
TASK_TIMEOUT_SECONDS=1800

# 素材回收站：软删除的素材超过这个天数，启动时会被彻底清理（记录 + 磁盘文件）。
# 0 = 关闭自动清理，只能手动清空回收站。
TRASH_RETENTION_DAYS=30
# 新用户的默认存储配额（GB）。0 = 不限。只作用于新建用户，存量用户不动。
DEFAULT_STORAGE_QUOTA_GB=20

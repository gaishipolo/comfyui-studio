# ComfyUI Workbench 配置示例。复制为 backend/.env 后按需修改。
# 请从 backend/ 目录启动后端；下列数据库和目录相对路径都以该工作目录为基准。

# 应用
APP_NAME=ComfyUI Workbench
APP_VERSION=0.1.0
APP_TIMEZONE=Asia/Shanghai

# 安全。生产环境必须设置随机 SECRET_KEY，并把 CORS_ORIGINS 收紧为前端域名。
# ADMIN_INITIAL_PASSWORD 留空时，首次启动会生成随机密码并在控制台打印一次。
SECRET_KEY=
ADMIN_INITIAL_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQL_ECHO=false

# 数据库（当前支持 SQLite + aiosqlite）
DATABASE_URL=sqlite+aiosqlite:///./workbench.db

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=300

# 通用 HTTP API 引擎。密钥留空，启用前再通过安全方式填写。
GENERIC_API_BASE_URL=
GENERIC_API_KEY=
GENERIC_API_SUBMIT_PATH=/generate
GENERIC_API_STATUS_PATH=/tasks/{task_id}
GENERIC_API_KEY_HEADER=Authorization
GENERIC_API_KEY_PREFIX=Bearer
GENERIC_API_TIMEOUT=300
GENERIC_API_DOWNLOAD_TIMEOUT=60

# 文件存储与工作流
STORAGE_BACKEND=local
STORAGE_DIR=./storage
WORKFLOW_DIR=./workflows
# Settings 字段；留空时依次查找系统 ffmpeg 和 imageio-ffmpeg 自带二进制。
FFMPEG_PATH=
FRONTEND_DIST=../frontend/dist

# MinIO / S3 兼容存储（仅 STORAGE_BACKEND=minio 时使用）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=comfyui-workbench
MINIO_SECURE=false
MINIO_REGION=

# 任务调度
MAX_CONCURRENT_TASKS=2
TASK_POLL_INTERVAL=2.0
TASK_TIMEOUT_SECONDS=1800
